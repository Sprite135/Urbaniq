# Copy to .env.local for local dev (never commit .env.local)

# API (local Vite proxy uses /api/v1; production uses full URL)
VITE_API_BASE_URL=/api/v1

# Optional public contact details. Empty values hide unconfigured social links.
VITE_SUPPORT_EMAIL=
VITE_FACEBOOK_URL=
VITE_INSTAGRAM_URL=
VITE_TWITTER_URL=
VITE_YOUTUBE_URL=
