# --- Docker compose local secrets (copy to .env and fill in) ---
DOCKER_USERNAME=urbaniq

# SQL Server (mssql) — must meet complexity policy (upper/lower/digit/symbol, >=8)
MSSQL_SA_PASSWORD=CHANGE_ME_Strong@Pass1

# Redis
REDIS_PASSWORD=CHANGE_ME_Redis@Pass1

# Connection strings consumed by the api service
PROD_DB_CONNECTION=Server=db,1433;Database=EcommerceDb;User Id=sa;Password=CHANGE_ME_Strong@Pass1;TrustServerCertificate=True;Encrypt=False;
REDIS_CONNECTION_STRING=redis:6379,password=CHANGE_ME_Redis@Pass1

# Core app secrets
JWT_SECRET_KEY=CHANGE_ME_GenerateA_48CharRandomKey_ForSigning
ADMIN_EMAIL=admin@pccomponents.com
ADMIN_PASSWORD=CHANGE_ME_Admin@Pass1

# External integrations (set real values when available)
STRIPE_SECRET_KEY=SET_VIA_ENVIRONMENT_VARIABLE
STRIPE_PUBLISHABLE_KEY=SET_VIA_ENVIRONMENT_VARIABLE
STRIPE_WEBHOOK_SECRET=SET_VIA_ENVIRONMENT_VARIABLE
CLOUDINARY_CLOUD_NAME=SET_VIA_ENVIRONMENT_VARIABLE
CLOUDINARY_API_KEY=SET_VIA_ENVIRONMENT_VARIABLE
CLOUDINARY_API_SECRET=SET_VIA_ENVIRONMENT_VARIABLE
TWILIO_ACCOUNT_SID=SET_VIA_ENVIRONMENT_VARIABLE
TWILIO_AUTH_TOKEN=SET_VIA_ENVIRONMENT_VARIABLE
TWILIO_FROM_NUMBER=SET_VIA_ENVIRONMENT_VARIABLE
SMTP_HOST=SET_VIA_ENVIRONMENT_VARIABLE
SMTP_PORT=587
SMTP_USERNAME=SET_VIA_ENVIRONMENT_VARIABLE
SMTP_PASSWORD=SET_VIA_ENVIRONMENT_VARIABLE
SMTP_FROM_ADDRESS=no-reply@urbaniq.com
FRONTEND_URL=https://urbaniq.ddnsking.com
