# ============================================
# Urbaniq Environment Variables Configuration
# ============================================
# Copy this file to .env and fill in the actual values
# DO NOT commit .env to version control

# ============================================
# General Configuration
# ============================================
ASPNETCORE_ENVIRONMENT=Development

# ============================================
# Database Configuration
# ============================================
# SQL Server password (must be strong for production)
SQL_SERVER_PASSWORD=YourStrongPassword123!

# Connection string for SQL Server
# Format: Server=db,1433;Database=UrbaniqDb;User Id=sa;Password={SQL_SERVER_PASSWORD};TrustServerCertificate=True;MultipleActiveResultSets=true
DB_CONNECTION_STRING=Server=db,1433;Database=UrbaniqDb;User Id=sa;Password=YourStrongPassword123!;TrustServerCertificate=True;MultipleActiveResultSets=true

# ============================================
# Redis Configuration
# ============================================
# Redis connection string
REDIS_CONNECTION_STRING=redis:6379

# ============================================
# JWT Authentication Configuration
# ============================================
# Secret key for JWT tokens (must be at least 32 characters for production)
JWT_SECRET_KEY=YourSuperSecureJwtSecretKeyForProductionUse123
JWT_ISSUER=https://your-domain.com
JWT_AUDIENCE=https://your-domain.com
JWT_EXPIRATION_MINUTES=60

# ============================================
# Email Configuration (Optional)
# ============================================
# SMTP server configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM_ADDRESS=noreply@your-domain.com
EMAIL_FROM_NAME=Urbaniq

# ============================================
# Stripe Configuration (Optional)
# ============================================
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================
# Cloudinary Configuration (Optional)
# ============================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# Payment Methods Configuration
# ============================================
# Yape configuration
YAPE_PHONE=999888777
YAPE_OWNER_NAME=Your Name

# Plin configuration
PLIN_PHONE=999888777
PLIN_OWNER_NAME=Your Name

# ============================================
# Admin Configuration
# ============================================
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=YourSecureAdminPassword123!

# ============================================
# Frontend URL Configuration
# ============================================
FRONTEND_URL=http://localhost:5173

# ============================================
# Sentry Configuration (Optional)
# ============================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
